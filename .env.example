REPO_CHAT_ENVIRONMENT=development
REPO_CHAT_SERVICE_NAME=repository-chat
REPO_CHAT_LOG_LEVEL=INFO
REPO_CHAT_MCP_HOST=127.0.0.1
REPO_CHAT_MCP_PORT=8001
REPO_CHAT_GRAPH_AGENT_PORT=8002
REPO_CHAT_CODE_ANALYST_PORT=8003
REPO_CHAT_ORCHESTRATOR_PORT=8004
REPO_CHAT_REPOSITORY_AGENT_PORT=8005
REPO_CHAT_GATEWAY_HOST=127.0.0.1
REPO_CHAT_GATEWAY_PORT=8000
REPO_CHAT_GATEWAY_HOST_PORT=8000
REPO_CHAT_INDEXER_PORT=8001
REPO_CHAT_GRAPH_PORT=8002
REPO_CHAT_ANALYST_PORT=8003
REPO_CHAT_ORCHESTRATOR_HOST_PORT=8004
REPO_CHAT_REPOSITORY_AGENT_HOST_PORT=8005
REPO_CHAT_CONVERSATION_MAXIMUM_TURNS=10
REPO_CHAT_CONVERSATION_TTL_SECONDS=86400
REPO_CHAT_RESPONSE_CACHE_TTL_SECONDS=3600
REPO_CHAT_ROUTING_AUDIT_TTL_SECONDS=604800
REPO_CHAT_ROUTING_AUDIT_MAXIMUM_RECORDS=100
REPO_CHAT_INDEXER_MCP_URL=http://127.0.0.1:8001/mcp
REPO_CHAT_GRAPH_AGENT_MCP_URL=http://127.0.0.1:8002/mcp
REPO_CHAT_CODE_ANALYST_MCP_URL=http://127.0.0.1:8003/mcp
REPO_CHAT_ORCHESTRATOR_MCP_URL=http://127.0.0.1:8004/mcp
REPO_CHAT_REPOSITORY_AGENT_MCP_URL=http://127.0.0.1:8005/mcp
REPO_CHAT_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
REPO_CHAT_GIT_COMMAND_TIMEOUT_SECONDS=120
REPO_CHAT_GIT_MAXIMUM_SNAPSHOT_BYTES=500000000
# UID/GID used only by the repository-agent to write controlled host snapshots.
REPO_CHAT_UID=1000
REPO_CHAT_GID=1000
REPO_CHAT_SOURCE_MAXIMUM_FILE_BYTES=1000000
REPO_CHAT_SOURCE_MAXIMUM_SNIPPET_LINES=40

# Host-side development values. Future app containers will override these
# hostnames to `redis` and `neo4j` on the private Compose network.
REPO_CHAT_REDIS_URL=redis://localhost:6379/0
REPO_CHAT_REDIS_PORT=6379
REPO_CHAT_INDEX_JOB_TTL_SECONDS=604800
REPO_CHAT_INDEX_LOCK_TTL_SECONDS=7200

REPO_CHAT_NEO4J_URI=bolt://localhost:7687
REPO_CHAT_NEO4J_USERNAME=neo4j
REPO_CHAT_NEO4J_PASSWORD=replace-with-your-neo4j-password
REPO_CHAT_NEO4J_DATABASE=neo4j
REPO_CHAT_NEO4J_HTTP_PORT=7474
REPO_CHAT_NEO4J_BOLT_PORT=7687
REPO_CHAT_NEO4J_HEAP_INITIAL=512m
REPO_CHAT_NEO4J_HEAP_MAX=1G
REPO_CHAT_NEO4J_PAGECACHE=512m

# Container-to-database settings. Defaults target the local Compose Neo4j.
# Override these values to use Aura from the containerized application services.
REPO_CHAT_CONTAINER_NEO4J_URI=bolt://neo4j:7687
REPO_CHAT_CONTAINER_NEO4J_USERNAME=neo4j
REPO_CHAT_CONTAINER_NEO4J_DATABASE=neo4j

REPO_CHAT_REPOSITORY_ROOT=/data/repositories
REPO_CHAT_REPOSITORY_HOST_PATH=./repositories

# Local open-source semantic retrieval. The embedding model is downloaded on first use.
REPO_CHAT_SEMANTIC_SEARCH_ENABLED=true
REPO_CHAT_QDRANT_URL=http://localhost:6333
REPO_CHAT_QDRANT_PORT=6333
REPO_CHAT_QDRANT_COLLECTION=repository_code
REPO_CHAT_QDRANT_API_KEY=
REPO_CHAT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
REPO_CHAT_EMBEDDING_CACHE_DIR=/tmp/repo-chat-models
REPO_CHAT_SEMANTIC_CHUNK_MAXIMUM_CHARACTERS=4000
REPO_CHAT_SEMANTIC_SEARCH_LIMIT=12

REPO_CHAT_AGENT_TIMEOUT_SECONDS=10
REPO_CHAT_AGENT_MAX_RETRIES=2
REPO_CHAT_AGENT_RETRY_BASE_SECONDS=0.1
REPO_CHAT_SEMANTIC_AGENT_TIMEOUT_SECONDS=120
REPO_CHAT_GATEWAY_ORCHESTRATOR_TIMEOUT_SECONDS=180
REPO_CHAT_GATEWAY_MAXIMUM_CONCURRENT_CHATS=32

# Optional evidence-grounded answer generation. Deterministic synthesis remains the default.
REPO_CHAT_LLM_ENABLED=false
REPO_CHAT_LLM_API_KEY=
REPO_CHAT_LLM_MODEL=openai/gpt-oss-20b
REPO_CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
REPO_CHAT_LLM_TIMEOUT_SECONDS=20
REPO_CHAT_LLM_MAXIMUM_INPUT_CHARACTERS=20000
REPO_CHAT_LLM_MAXIMUM_OUTPUT_TOKENS=1200
